PORT=5000
NODE_ENV=development

# URL của Frontend được phép gọi API (chống CORS từ domain lạ)
CLIENT_URL=http://localhost:3000

# Thông tin kết nối Supabase (Dùng Service Role Key ở BE, TUYỆT ĐỐI KHÔNG đưa lên FE)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Khóa bí mật ký JWT (Hãy thay bằng chuỗi ngẫu nhiên dài ít nhất 32 ký tự)
JWT_SECRET=super_secret_jwt_key_change_this_in_production_2026
JWT_EXPIRES_IN=7d

# Tài khoản Admin mặc định dùng khi chạy lệnh npm run seed:admin
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMe123!


# Cấu hình Cloudinary lưu trữ & tối ưu ảnh
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
